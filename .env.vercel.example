# Visora on Vercel: every setting you add yourself. docs/vercel.md explains where each value comes from.
# Copy to .env.vercel (git ignores it), fill it in, then in Vercel use Settings > Environment Variables > Import .env.
# Everything else is built into Dockerfile.vercel. Never commit real values.

# Neon: the POOLED connection string. If you add Neon from the Vercel Marketplace, it sets this for you.
DATABASE_URL=postgresql://neondb_owner:npg_BlHLiaUCK9o4@ep-blue-flower-beqd2f10-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Vercel Blob (PRIVATE store): connecting the store to the project sets this for you.
BLOB_READ_WRITE_TOKEN=

# Signs sessions, download links and job-runner requests. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CC_SIGNING_KEY=

# Google sign-in: "Web application" client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email. Works with any SMTP provider. These values are for a Gmail app password, which needs no new account:
# https://myaccount.google.com/apppasswords (Gmail allows about 500 emails a day; move to a provider with your own domain as you grow)
CC_SMTP_HOST=smtp.gmail.com
CC_SMTP_PORT=587
CC_SMTP_USER=
CC_SMTP_PASSWORD=
CC_MAIL_FROM=Visora <you@gmail.com>

# Shown on the pricing and legal pages, for sales, privacy and support requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Only with a custom domain, e.g. https://visora.ai (otherwise your Vercel production domain is used automatically):
# CC_PUBLIC_URL=
# NEXT_PUBLIC_SITE_URL=

# Only on Vercel Pro, after raising Max Duration to 800 s and CPU to Performance (docs/vercel.md). These allow the paid plans' longer videos:
# CC_FUNCTION_SECONDS=800
# CC_MAX_VIDEO_GIGAPIXELS=15
# CC_MAX_VIDEO_MB=1024
# CC_RUNNER_CONCURRENCY=2
