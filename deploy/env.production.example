# Production backend settings. Copy to deploy/.env on the backend VM (chmod 600). Never commit deploy/.env.
# The app refuses to start with CC_ENV=production while any development stand-in is configured (app/config.py).
CC_ENV=production
CC_SECURE_COOKIES=1
CC_INLINE_WORKER=0
CC_LOG_FORMAT=json

# Public addresses. The web app (Next.js on Vercel, app.example.com) proxies /api/* and /auth/google/* to this API
# (api.example.com), so browsers only ever see the app origin: sign-in links, the Google callback and cookies use it.
CC_PUBLIC_URL=https://app.example.com
CC_APP_URL=https://app.example.com
CC_API_DOMAIN=api.example.com                 # used by the Caddy profile for automatic HTTPS
# Uvicorn takes the client IP from X-Forwarded-For (set by Vercel's proxy and Caddy) so per-IP sign-in limits apply
# per person, not per proxy. Anyone calling api.example.com directly could spoof it; per-email and per-code limits
# still apply. Restrict ingress to the proxy if your network allows it.
FORWARDED_ALLOW_IPS=*

# Neon: console -> project -> Connect -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
CC_DB_POOL_SIZE=10
CC_DB_POOL_MAX_IDLE=60

# Cloudflare R2: dashboard -> R2 -> bucket (private) + API token with Object Read & Write on that bucket
CC_S3_BUCKET=context-commerce-media
CC_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
CC_S3_REGION=auto
CC_S3_SSE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CC_S3_PRESIGN_TTL=300

# Google sign-in: OAuth client (Web application); authorised redirect URI https://app.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP): e.g. Resend smtp.resend.com:587 user "resend", password = API key; sender on a verified domain
CC_MAIL_BACKEND=smtp
CC_SMTP_HOST=
CC_SMTP_PORT=587
CC_SMTP_TLS=starttls
CC_SMTP_USER=
CC_SMTP_PASSWORD=
CC_MAIL_FROM=Visora <signin@example.com>

# Secrets generated on the server: python -c "import secrets; print(secrets.token_urlsafe(48))"
CC_SIGNING_KEY=
CC_OPS_TOKEN=

# Container sizing for the VM (see docs/v10/worker-deployment.md). Quality checks run on the API.
CC_API_CPUS=2.0
CC_API_MEM_LIMIT=2g
CC_WORKER_REPLICAS=1
CC_WORKER_CPUS=2.0
CC_WORKER_MEM_LIMIT=3g
CC_WORKER_MAX_IDLE_SECONDS=900
CC_CLAMAV_REQUIRED=0

# Optional: Cloudflare Tunnel instead of Caddy (no inbound ports)
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: alerts from `python -m ops.monitor`
CC_ALERT_WEBHOOK_URL=
