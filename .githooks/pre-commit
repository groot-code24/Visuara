#!/bin/sh
# Refuses a commit when anything in the working tree looks like a credential (qa/secret_scan.py prints file, line and
# kind, never the value). Enable once per clone:  git config core.hooksPath .githooks
PY=python
[ -x .venv311/Scripts/python.exe ] && PY=.venv311/Scripts/python.exe
[ -x .venv/bin/python ] && PY=.venv/bin/python
"$PY" qa/secret_scan.py || { echo "Commit refused: remove the credential above (keep secrets in .env.vercel, which git ignores)."; exit 1; }
