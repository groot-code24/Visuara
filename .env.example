# Copy to .env and fill in. The app reads .env at startup; real environment variables take precedence.
# Never commit .env or share it: it holds credentials.

# Public base URL (used in sign-in emails and as the Google redirect URI). Set CC_SECURE_COOKIES=1 behind HTTPS.
CC_PUBLIC_URL=http://127.0.0.1:8000
CC_SECURE_COOKIES=0

# Shared data directory (working copy of media). Keep the API and worker pointed at the same volume.
CC_DATA_DIR=./data
CC_INLINE_WORKER=1

# --- Database: Neon PostgreSQL. Without it the app uses SQLite in CC_DATA_DIR.
# Neon console -> your project -> Connect -> copy the connection string (pooled is fine).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# CC_DB_POOL_SIZE=10

# --- Object storage: any S3-compatible private bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# CC_S3_BUCKET=context-commerce-media
# CC_S3_REGION=us-east-1
# CC_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# CC_S3_PREFIX=prod
# CC_S3_PRESIGN_TTL=300
# CC_S3_SSE=AES256            # set empty for providers that encrypt by default and reject the header

# --- Sign in with Google (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Authorised redirect URI: <CC_PUBLIC_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# --- Email sign-in (one-time code + magic link) over SMTP. Works with Gmail (app password), Resend, SendGrid, SES, Postmark.
# CC_SMTP_HOST=smtp.resend.com
# CC_SMTP_PORT=587
# CC_SMTP_TLS=starttls        # starttls | ssl | none
# CC_SMTP_USER=resend
# CC_SMTP_PASSWORD=...
# CC_MAIL_FROM=Context Commerce <signin@yourdomain.com>
# CC_SIGNIN_CODE_TTL=600
# Development only: write emails to CC_DATA_DIR/outbox instead of sending them.
# CC_MAIL_BACKEND=outbox

# Optional local vision descriptions via Ollama.
# CC_VISION_MODEL=llava
# CC_OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Optional malware scanning. Use required=1 in a production deployment to fail closed.
# CC_CLAMAV_HOST=clamav
# CC_CLAMAV_PORT=3310
# CC_CLAMAV_REQUIRED=1

# Optional generative video insertion via Replicate.
# Pick a model that supports editing a source video using a product reference image.
# Inspect that model's input schema first; field names below are examples only.
# CC_REPLICATE_API_TOKEN=your-token
# CC_REPLICATE_MODEL=owner/model-name:version-id
# CC_REPLICATE_INPUT_TEMPLATE={"video":"{{video}}","product_image":"{{product_image}}","prompt":"{{prompt}}"}
# Generative processing guardrails (tune to the chosen provider/model)
CC_GENERATIVE_MAX_VIDEO_SECONDS=30
CC_GENERATIVE_MAX_INPUT_BYTES=104857600
CC_GENERATIVE_MAX_OUTPUT_BYTES=1073741824
# CC_GENERATIVE_OUTPUT_HOSTS=replicate.delivery,replicate.com,storage.googleapis.com

# Worker lease (seconds); workers renew it while rendering. Expired leases are recovered by other workers.
CC_JOB_LEASE_SECONDS=120
# Maximum tracked span (reference frame to end) analysed per placement, in seconds.
CC_MAX_ANALYSIS_SECONDS=60
# Generative rendering stays unavailable until an operator has run a live integration check and sets this to 1.
# Even then, generative outputs are not marked successful because they cannot be validated automatically.
# CC_REPLICATE_VERIFIED=0

# Signing key for download links, sign-in codes and OAuth state (default: random key in CC_DATA_DIR/.signing_key).
# REQUIRED when more than one host runs the app (API + worker on different machines): every host needs the same key.
# CC_SIGNING_KEY=change-me-to-a-long-random-secret
CC_DOWNLOAD_LINK_TTL=300
