# Local development settings. Copy to .env (never commit .env). Real environment variables take precedence.
# Production settings go in Vercel: see docs/vercel.md.
# With nothing configured the API runs on SQLite + local disk with an inline worker, and sign-in emails go to an outbox.
# The web app (web/, Next.js) runs on http://localhost:3000 and proxies /api to this API (CC_API_ORIGIN in web/).

CC_ENV=development
CC_PUBLIC_URL=http://localhost:3000             # where people open the app: magic links and the Google callback use it
CC_SECURE_COOKIES=0
CC_DATA_DIR=./data
CC_INLINE_WORKER=1
CC_LOG_FORMAT=text

# Email sign-in without a provider: messages are written to CC_DATA_DIR/outbox (development only;
# refused when CC_ENV=production). For a real inbox locally, `docker compose up` includes Mailpit.
CC_MAIL_BACKEND=outbox

# --- Optional: PostgreSQL / Neon instead of SQLite
# DATABASE_URL=postgresql://cc:cc-local-only@127.0.0.1:5433/context_commerce      # docker compose postgres
# CC_DB_POOL_SIZE=10
# CC_DB_POOL_MAX_IDLE=60          # seconds an idle connection stays open (0 kept = lets Neon scale to zero)

# --- Optional: S3-compatible storage (the docker compose stack provides one on :8333)
# CC_S3_BUCKET=context-commerce-dev
# CC_S3_ENDPOINT_URL=http://127.0.0.1:8333
# CC_S3_PUBLIC_ENDPOINT_URL=      # set when browsers reach storage on a different address than the server
# CC_S3_REGION=us-east-1
# CC_S3_ADDRESSING=path
# CC_S3_SSE=                      # empty for stores that reject the AES256 header
# AWS_ACCESS_KEY_ID=cc-local
# AWS_SECRET_ACCESS_KEY=cc-local-secret-only

# --- Optional: Google sign-in (Google Cloud console -> Credentials -> OAuth client ID, "Web application")
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <CC_PUBLIC_URL>/auth/google/callback (locally http://localhost:3000/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: real SMTP (replaces the outbox): Resend, Brevo, Gmail app password, SES, Postmark...
# CC_MAIL_BACKEND=smtp
# CC_SMTP_HOST=smtp.resend.com
# CC_SMTP_PORT=587
# CC_SMTP_TLS=starttls            # starttls | ssl | none
# CC_SMTP_USER=resend
# CC_SMTP_PASSWORD=
# CC_MAIL_FROM=Visuara <signin@yourdomain.com>

# --- Plans: new workspaces start on this plan (free | pro | team | enterprise); change one with `python -m ops.plans`
# CC_DEFAULT_PLAN=free

# --- Decision engine
# CC_DECISION_WINDOW_SECONDS=5            # how long each candidate surface is tracked
# CC_DECISION_CANDIDATES_PER_VIDEO=4      # surfaces tracked per video (more = slower, more thorough)

# --- Limits and quotas (defaults shown)
# CC_MAX_VIDEO_MB=2048
# CC_MAX_VIDEO_SECONDS=600
# CC_MAX_VIDEO_WIDTH=3840
# CC_MAX_VIDEO_HEIGHT=2160
# CC_MAX_VIDEO_FPS=120
# CC_MAX_IMAGE_MB=10
# CC_JOB_MAX_SECONDS=1800
# CC_ORG_STORAGE_QUOTA_MB=1048576
# CC_ORG_DAILY_VIDEO_UPLOADS=1000
# CC_ORG_MAX_ACTIVE_JOBS=50
# CC_ORG_QUALITY_CHECKS_PER_HOUR=40
# CC_ORG_ANALYSES_PER_HOUR=30
# CC_ORG_MAX_MEMBERS=25
# CC_AUTH_RATE_PER_MINUTE=12

# --- Worker and housekeeping
# CC_WORKER_MAX_IDLE_SECONDS=900  # longest idle poll; queued jobs wake workers immediately via the data volume
# CC_JOB_LEASE_SECONDS=120
# CC_CACHE_MAX_AGE_HOURS=72       # local copies of media already in the bucket are evicted after this
# CC_CACHE_MAX_MB=20480
# CC_MAINTENANCE_INTERVAL_SECONDS=21600

# --- Optional integrations
# CC_DETECTION_MODEL=yolox-tiny   # object detection (app/detection.py); `none` switches it off. Install with: python ops/fetch_models.py
# CC_DETECTION_MIN_CONFIDENCE=0.35
# CC_VISION_MODEL=llava           # an Ollama-compatible vision model on a server you run: validated scene descriptions (app/vision.py)
# CC_OLLAMA_URL=http://127.0.0.1:11434/api/generate
# CC_CLAMAV_HOST=clamav
# CC_CLAMAV_PORT=3310
# CC_CLAMAV_REQUIRED=1
CC_GENERATIVE_MAX_VIDEO_SECONDS=30
CC_GENERATIVE_MAX_INPUT_BYTES=104857600
CC_GENERATIVE_MAX_OUTPUT_BYTES=1073741824

# Signing key for download links, sign-in codes and OAuth state. Optional locally (a random key is generated in
# CC_DATA_DIR); REQUIRED in production and identical on every host.
# CC_SIGNING_KEY=
CC_DOWNLOAD_LINK_TTL=300

# --- Marketplace (all optional; the defaults are shown)
# CC_PLATFORM_FEE_BPS=2000                 # platform fee in basis points (2000 = 20%) of each paid placement
# CC_RESERVATION_HOLD_SECONDS=900          # how long a brand's reservation holds an item
# CC_REQUEST_RESPONSE_SECONDS=259200       # how long the publisher has to answer a placement request
# CC_HASH_BACKFILL_PER_RUN=2               # older videos hashed per maintenance run

# --- Analysis pipeline (optional; stored with every analysis version, see app/intelligence.py DEFAULT_CONFIG)
# CC_ANALYSIS_SAMPLE_SECONDS=0.25
# CC_ANALYSIS_CUT_THRESHOLD=0.35
# CC_ANALYSIS_MIN_SCENE_SECONDS=1.0
# CC_ANALYSIS_FRAMES_PER_SCENE=3
# CC_ANALYSIS_VISIBILITY_STEP_SECONDS=0.5
# CC_ANALYSIS_TRACK_MIN_IOU=0.5
# CC_ANALYSIS_MAX_SURFACES_PER_SCENE=3
# CC_ANALYSIS_CUT_GAIN_NORMALISE=1
